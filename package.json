{
  "name": "dsh-550-boot",
  "version": "0.1.0",
  "description": "DSH 开机动画：550C 上游片头、550W 终端工作台（完整档 15.45 秒 / 简易档 3.05 秒）与 550A 开发中占位；通用设置可切换机型、档位、配色或关闭。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "Ziyang Song",
    "url": "https://github.com/yannicksong0106"
  },
  "contributors": [
    {
      "name": "Voidpoket",
      "url": "https://github.com/Voidpoket",
      "comment": "550C 片头动画与 HTML 源码（assets/550C-source.html）"
    },
    {
      "name": "Sun-sh902",
      "url": "https://github.com/Sun-sh902",
      "comment": "550W 机型、550A 占位、终端工作台版式与构建/验证工具改造"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sun-sh902/Dsh-550-Boot.git"
  },
  "homepage": "https://github.com/Sun-sh902/Dsh-550-Boot#readme",
  "bugs": {
    "url": "https://github.com/Sun-sh902/Dsh-550-Boot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "boot-animation",
    "splash",
    "startup",
    "theme",
    "web-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "web:index-inject",
      "dom:overlay",
      "browser:local-storage",
      "desktop:titlebar-overlay"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.0-rc.1"
      ]
    },
    "capability": {
      "id": "boot-splash",
      "kind": "ui",
      "invocation": "Boot the profile's Web GUI, then read the first frame from the page: document.querySelector('.dsh550c-host') and its shadowRoot's #boot stage, plus document.documentElement.classList.contains('dsh550c-first') on the way in.",
      "expected": "The host half's first frame covers the shell while the document is still parsing, so DSH's [data-dsh-boot] card is never visible; the client splash then mounts the ported #boot stage in a shadow root on the same task that retires that cover, and plays to completion."
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "build": "node scripts/extract.mjs && node scripts/build.mjs",
    "check": "node --check lib/client.js && node --check lib/index.js",
    "audit:leak": "node tools/leak-audit.mjs",
    "render:splash": "node tools/render-splash.mjs",
    "measure:perf": "node tools/measure-perf.mjs",
    "verify:reduced-motion": "node tools/verify-reduced-motion.mjs",
    "verify:variant-bg": "node tools/verify-variant-bg.mjs",
    "verify:variant-row": "node tools/verify-variant-row.mjs",
    "probe:550w": "node tools/probe-550w.mjs",
    "verify:skip": "node tools/verify-skip.mjs",
    "prepublishOnly": "node scripts/extract.mjs && node scripts/build.mjs && node --check lib/client.js && node --check lib/index.js"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
